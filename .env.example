# ---- copy to .env and fill in. .env is gitignored. ----

# LLM (OpenRouter). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Outbound email (Resend). https://resend.com/api-keys
RESEND_API_KEY=
# With no verified domain, Resend only allows this exact from-address:
MAIL_FROM=JotPsych Machine <onboarding@resend.dev>
# ...and it may only deliver to the address you signed up with:
MAIL_TO_OVERRIDE=

# Safety
DRY_RUN=1          # 1 = write .eml files to out/outbox instead of sending
MAX_SENDS_PER_RUN=5

# ---- Where the list comes from (optional) -------------------------------
# Any URL returning CSV: Google Sheets "Publish to web", an Airtable view,
# a CRM report export, a signed S3 link. Columns: name, email, mobile.
# If unset, the machine reads inbox/dormant.csv, then inbox/dormant.sample.csv.
DORMANT_URL=
SUPPRESS_URL=
PEERS_URL=
RETURNS_URL=

# ---- Scale --------------------------------------------------------------
# Registry lookups per run. Cost per run stays flat however long the list is.
RESOLVE_BUDGET_PER_RUN=400
# How often each clinician's profile is refreshed from the registry.
RESOLVE_TTL_DAYS=14
