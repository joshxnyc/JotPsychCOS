# ---- copy to .env and fill in. .env is gitignored. ----

# LLM (OpenRouter). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Outbound email (Resend). https://resend.com/api-keys
RESEND_API_KEY=
# With no verified domain, Resend only allows this exact from-address:
MAIL_FROM=JotPsych Machine <onboarding@resend.dev>
# ...and it may only deliver to the address you signed up with:
MAIL_TO_OVERRIDE=

# Safety
DRY_RUN=1          # 1 = write .eml files to out/outbox instead of sending
MAX_SENDS_PER_RUN=5
